# deepseek-v41-flash-4x-cmp170hx: DeepSeek-V4.1-Flash-1017 on 4x CMP 170HX (GNmac-lab recipe 1.2.0 @ 2ad5741ab1, patched)
# Copy to .env in the recipe root. start.sh and serve.sh source it with `set -a`: quote any value that contains a space.
# This file holds no secrets. If you add an API key to EXTRA_ARGS, keep your .env out of version control.
MODELS_DIR=/opt/models
LAYOUT=tp4
# Validation: API on localhost only. Open it to the LAN later, with a key (EXTRA_ARGS="... --api-key ...").
BIND=127.0.0.1
PORT=8011
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=8
GPU_MEMORY_UTILIZATION=0.98
P2P=1
# Fidelity first: no DSpark drafter (it is lossless; turning it off frees about 2.8 GiB per card for the KV cache)
SPEC_TOKENS=0
# Engram tables: ALWAYS ssd. On this stack an empty value ("host" mode) leaves the tables unfilled (see README).
# They are read from a tmpfs in RAM prepared by engram-ram.sh; to read them from disk instead, empty ENGRAM_HOST_DIR.
ENGRAM_STORAGE=ssd
ENGRAM_HOST_DIR=/opt/engram-ram/DeepSeek-V4.1-Flash-1017-engram
# Makes prefix-cache use observable (usage.prompt_tokens_details.cached_tokens)
EXTRA_ARGS=--enable-prompt-tokens-details
IMAGE=ds41-cmp170hx:1.2.0-fidelity
NAME=ds41-flash
CACHE_DIR=/opt/dsv41-gnmac/cache
# exllamav3 "fat expert" path disabled (lazy buffers not counted in the memory budget; needed with 4-bit layers)
VLLM_EXL3_FAT_THRESHOLD=2048
